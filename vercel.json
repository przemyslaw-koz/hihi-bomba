{
    "cleanUrls": true,
    "redirects": [],
    "rewrites": [
      { "source": "/health", "destination": "/health.json" },
      { "source": "/ready", "destination": "/ready.json" }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  }
